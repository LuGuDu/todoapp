<div class="container">
  <div class="items">
    <div class="items-head">
      <p style="text-align : center ;">ADD TASK TO <%= @project.title%>
        <p>
        </div>
        <div class="items-body">
          <form action="/project/add" method='post' value='task'>
            <form class="form-container">
              <div class="form-row">
                <label for="title">Title:</label>
                <input type="text" id="title" name="title" placeholder="Title">
              </div>
              <!--div class="form-row">
        <label for="description">Description:</label>
        <input type="text" id="description" name="description" placeholder="Description">
      </div-->
              <div class="form-row">
                <label>Priority:</label>
                <div class="priority-group">
                  <input type="radio" id="p1" name="priority" value="1">
                  <label for="p1" class="priority-btn priority-1">1</label>
                  <input type="radio" id="p2" name="priority" value="2">
                  <label for="p2" class="priority-btn priority-2">2</label>
                  <input type="radio" id="p3" name="priority" value="3">
                  <label for="p3" class="priority-btn priority-3">3</label>
                  <input type="radio" id="p4" name="priority" value="4">
                  <label for="p4" class="priority-btn priority-4">4</label>
                </div>
              </div>
              <div class="form-row">
                <label for="deadline">Deadline:</label>
                <input type="date" id="deadline" name="deadline">
              </div>
              <input style="display:none" type="hidden" id="project_id" name="project_id" value=<%= @project.id %> >
              <% if current_user.role =="admin" %>
                <label for="lname">User:</label><br>
                <select name="user_id">
                  <% @users.each do |user| %>
                    <option value=<%= user.id %>><%= user.email%></option>
                    <% end %>
                  </select>
                <% end %>
                <div class="form-actions">
                  <input class="btn" type="submit" value="Create">
                  <% if current_user.role =="admin" %>
                    <a href="/task/all" class="btn">Cancel</a>
                  <% else %>
                    <%= link_to "Cancel", request.referer || tasks_path, class: "btn" %>
                  <% end %>
                </div>
              </form>
            </div>
          </div>
        </div>