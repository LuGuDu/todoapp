
<div class= "container "> 
    <div class="items">
            <div class="items-head">
                <div class="container_flex">
                        <p>ToDo List</p>
                        <div class="click_button">
                          <form action="/task/create" method="get">
                            <button type="submit" class="icon-btn">
                              <i class="fa fa-plus"></i>
                            </button>
                          </form>
                        </div>
                </div> 
            </div>
        <div class="items-body">
            <div class="items-body-content">
              <div class="tasks-container">
                <% @tasks.each do |task| %>
                  <div class="list-element">
                    <!-- Checkbox -->
                    <%= form_with url: task.done? ? "/task/uncheck/#{task.id}" : "/task/check/#{task.id}", 
                                  method: :patch, 
                                  local: true do %>
                      <%= check_box_tag "done", "1", task.done, 
                          onchange: "this.form.submit()", 
                          class: "round-check" %>
                    <% end %>

                    <!-- Título de la tarea -->
                    <span class="task-title <%= 'done' if task.done %>">
                      <%= task.title %>
                    </span>

                    <!-- Contenedor para acciones (a la derecha) -->
                    <div class="task-actions">
                      <%= button_to "/task/update/#{task.id}", method: :get, class: "icon-btn" do %>
                        <i class="fa fa-pen"></i>
                      <% end %>

                      <%= button_to "/task/delete/#{task.id}", method: :delete, class: "icon-btn", form: { data: { turbo_confirm: "¿Seguro que quieres borrar esta tarea?" } } do %>
                        <i class="fa fa-trash"></i>
                      <% end %>
                    </div>
                  </div>
                <% end %>
             </div>
             </div>
        </div>
    </div>
</div>
